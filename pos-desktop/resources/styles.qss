/* ═══════════════════════════════════════════════════════════════
   Zeebroo POS  ·  Professional Theme
   ═══════════════════════════════════════════════════════════════ */

/* ── Base reset ─────────────────────────────────────────────── */
QMainWindow, QDialog {
    background: #f0f2f7;
    color: #0f172a;
    font-family: "Inter", "SF Pro Display", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

QWidget {
    background: #ffffff;
    color: #0f172a;
    font-family: "Inter", "SF Pro Display", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

/* App background — makes panels look like floating cards */
#centralWidget {
    background: #eceef4;
}

#posSessionWidget {
    background: #eceef4;
}

/* ── Multi-session tab bar ───────────────────────────────────── */
#posTabWidget {
    background: #eceef4;
}

#posTabWidget::pane {
    background: #eceef4;
    border: none;
    padding: 0;
}

#posTabWidget QTabBar {
    background: #dde1ea;
    border-bottom: 1px solid #c8cfdb;
}

#posTabWidget QTabBar::tab {
    background: #e8ebf2;
    color: #64748b;
    border: none;
    border-right: 1px solid #d1d8e4;
    border-bottom: 2px solid transparent;
    padding: 0 20px;
    min-height: 34px;
    min-width: 130px;
    font-size: 12px;
    font-weight: 600;
    font-family: "Inter", "SF Pro Display", "Segoe UI", system-ui, sans-serif;
}

#posTabWidget QTabBar::tab:selected {
    background: #eceef4;
    color: #0f172a;
    border-bottom: 2px solid #6366f1;
    font-weight: 700;
}

#posTabWidget QTabBar::tab:hover:!selected {
    background: #eceef4;
    color: #334155;
}

#posTabWidget QTabBar::close-button {
    subcontrol-position: right;
    subcontrol-origin: padding;
    margin-left: 4px;
}

#posTabWidget QTabBar::close-button:hover {
    background: rgba(239, 68, 68, 0.14);
    border-radius: 3px;
}

#addSessionBtn {
    background: rgba(99, 102, 241, 0.10);
    color: #4f46e5;
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 6px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 700;
    font-family: "Inter", "SF Pro Display", "Segoe UI", system-ui, sans-serif;
    margin: 3px 6px 3px 0;
}

#addSessionBtn:hover {
    background: rgba(99, 102, 241, 0.18);
    border-color: rgba(99, 102, 241, 0.40);
}

#addSessionBtn:pressed {
    background: rgba(99, 102, 241, 0.26);
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ── Global scrollbars ──────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════
   Top bar
   ═══════════════════════════════════════════════════════════════ */
#topBar {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    min-height: 58px;
    max-height: 58px;
}

#brandBlock {
    background: transparent;
    border: none;
    min-width: 160px;
    max-width: 280px;
}

#brandIcon {
    font-size: 15px;
    font-weight: 900;
    color: #6366f1;
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    qproperty-alignment: AlignCenter;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(99, 102, 241, 0.18),
        stop:1 rgba(139, 92, 246, 0.18));
    border: 1px solid rgba(99, 102, 241, 0.28);
    border-radius: 11px;
}

#brandTitle {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #0f172a;
    padding: 0;
    margin: 0;
    background: transparent;
}

#statsBlock {
    background: transparent;
    border: none;
}

#statPill {
    padding: 5px 12px;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: #f8fafc;
    min-height: 28px;
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
}

#topBarSep {
    color: #e2e8f0;
    background: #e2e8f0;
    max-width: 1px;
    margin: 12px 0;
}

#topFieldsBlock {
    background: transparent;
    border: none;
}

#inputGroup {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 11px;
    min-height: 40px;
}

#inputGroup:focus-within {
    border-color: #6366f1;
    background: #ffffff;
}

#topBarInput {
    background: transparent;
    border: none;
    border-radius: 10px 0 0 10px;
    padding: 8px 12px;
    font-size: 13px;
    color: #0f172a;
    selection-background-color: rgba(99, 102, 241, 0.3);
}

#topBarInput:focus {
    border: none;
    outline: none;
}

#inputGroupBtn {
    background: transparent;
    border: none;
    border-left: 1.5px solid #e2e8f0;
    border-radius: 0 9px 9px 0;
    color: #94a3b8;
    font-size: 16px;
    font-weight: 700;
    padding: 0;
    min-width: 38px;
    max-width: 38px;
}

#inputGroupBtn:hover {
    background: rgba(99, 102, 241, 0.07);
    color: #6366f1;
}

#inputGroupBtn:pressed {
    background: rgba(99, 102, 241, 0.13);
}

#topActionsBlock {
    background: transparent;
    border: none;
}

#topActionBtn {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 11px;
    color: #64748b;
    font-size: 16px;
    font-weight: 700;
    padding: 0;
}

#topActionBtn:hover {
    border-color: #818cf8;
    background: rgba(99, 102, 241, 0.07);
    color: #6366f1;
}

#topActionBtn:pressed {
    background: rgba(99, 102, 241, 0.13);
    border-color: #6366f1;
}

/* ═══════════════════════════════════════════════════════════════
   Panels — shared card style
   ═══════════════════════════════════════════════════════════════ */
#panel {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
}

QLineEdit, QTextEdit, QDoubleSpinBox {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 11px;
    color: #0f172a;
    selection-background-color: rgba(99, 102, 241, 0.28);
}

QLineEdit:focus, QTextEdit:focus, QDoubleSpinBox:focus {
    border-color: #6366f1;
    background: #ffffff;
}

QLineEdit:hover, QTextEdit:hover, QDoubleSpinBox:hover {
    border-color: #c7d2fe;
    background: #ffffff;
}

#panelHeader {
    padding: 12px 16px;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: -0.3px;
    border-bottom: 1px solid #e2e8f0;
    background: #ffffff;
    color: #0f172a;
    border-radius: 17px 17px 0 0;
}

/* ═══════════════════════════════════════════════════════════════
   Category bar
   ═══════════════════════════════════════════════════════════════ */
#categoryBar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #f1f5f9;
}

#categoryScroll {
    background: transparent;
    border: none;
}

#categoryScroll QScrollBar:horizontal {
    height: 3px;
    margin: 0 16px 2px 16px;
    background: transparent;
}

#categoryScroll QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 2px;
    min-width: 32px;
}

#categoryScroll QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

#categoryScroll QScrollBar::add-line:horizontal,
#categoryScroll QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}

#categoryStrip {
    background: transparent;
}

#categoryPill, #categoryPillAll {
    padding: 0 16px;
    border-radius: 999px;
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    color: #64748b;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.1px;
}

#categoryPillAll {
    border-color: #e2e8f0;
    background: #f8fafc;
    color: #475569;
    font-weight: 700;
}

#categoryPill:hover, #categoryPillAll:hover {
    border-color: #a5b4fc;
    background: rgba(99, 102, 241, 0.06);
    color: #4338ca;
}

#categoryPill:checked, #categoryPillAll:checked {
    border-color: transparent;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #818cf8);
    color: #ffffff;
    font-weight: 700;
}

#categoryPill:checked:hover, #categoryPillAll:checked:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f46e5, stop:1 #6366f1);
}

#categoryPill:pressed, #categoryPillAll:pressed {
    background: #4338ca;
    border-color: transparent;
    color: #ffffff;
}

/* ═══════════════════════════════════════════════════════════════
   Product cards
   ═══════════════════════════════════════════════════════════════ */
#productCard {
    background: #ffffff;
    border: 1.5px solid #e8ecf3;
    border-radius: 16px;
}

#productCard:hover {
    border-color: #a5b4fc;
    background: #fbfbff;
}

#productCard:disabled {
    opacity: 0.48;
    background: #f8fafc;
    border-color: #e2e8f0;
}

#productImage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #eef2ff, stop:1 #f5f3ff);
    border-radius: 11px;
    border: none;
}

#productPlaceholder {
    font-size: 28px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #eef2ff, stop:1 #f5f3ff);
    border-radius: 11px;
    color: #a5b4fc;
    border: none;
}

#catalogEmpty {
    color: #94a3b8;
    font-size: 14px;
    padding: 60px 24px;
    background: transparent;
}

#productName {
    font-weight: 700;
    font-size: 12px;
    color: #0f172a;
    background: transparent;
    line-height: 1.35;
    letter-spacing: -0.1px;
}

#productMeta {
    color: #94a3b8;
    font-size: 10px;
    background: transparent;
    font-weight: 500;
    letter-spacing: 0.1px;
}

#productPrice {
    font-weight: 800;
    font-size: 14px;
    color: #0f172a;
    background: transparent;
    letter-spacing: -0.4px;
}

/* ═══════════════════════════════════════════════════════════════
   Current sale panel (left)
   ═══════════════════════════════════════════════════════════════ */
#salePanel {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
}

#salePanelHeader {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    border-radius: 17px 17px 0 0;
    min-height: 64px;
}

#salePanelTitle {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    background: transparent;
}

#saleItemBadge {
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    background: transparent;
    letter-spacing: 0.1px;
}

#saleHeaderSubtotal {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    min-width: 100px;
    background: transparent;
    letter-spacing: -0.6px;
}

#cartScroll {
    background: #f8fafc;
    border: none;
}

#cartContainer {
    background: #f8fafc;
}

#cartEmpty {
    background: transparent;
    border: none;
}

#cartEmptyIcon {
    font-size: 44px;
    padding-bottom: 6px;
    background: transparent;
}

#cartEmptyTitle {
    font-size: 15px;
    font-weight: 700;
    color: #334155;
    background: transparent;
    letter-spacing: -0.3px;
}

#cartEmptyHint {
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.5;
    max-width: 220px;
    background: transparent;
}

#cartLine {
    background: #ffffff;
    border: 1px solid #eef2f7;
    border-radius: 14px;
}

#cartLine:hover {
    border-color: #dde3ef;
}

#cartLineName {
    color: #0f172a;
    font-weight: 600;
    background: transparent;
    font-size: 13px;
    letter-spacing: -0.2px;
}

#cartSub {
    color: #94a3b8;
    font-size: 11px;
    background: transparent;
    font-weight: 500;
}

#cartLayerChip {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 8px;
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1px;
}

#cartQtyBtn {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 9px;
    color: #475569;
    font-size: 16px;
    font-weight: 700;
    padding: 0;
}

#cartQtyBtn:hover {
    border-color: #818cf8;
    background: rgba(99, 102, 241, 0.07);
    color: #4338ca;
}

#cartQtyBtn:pressed {
    background: rgba(99, 102, 241, 0.13);
    border-color: #6366f1;
}

#cartQty {
    min-height: 32px;
    max-height: 32px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 800;
    border: 1.5px solid #e2e8f0;
    border-radius: 9px;
    background: #f8fafc;
    color: #0f172a;
    letter-spacing: -0.2px;
}

#cartQty:focus {
    border-color: #6366f1;
    background: #ffffff;
}

#cartLineTotal {
    color: #0f172a;
    font-weight: 800;
    min-width: 80px;
    background: transparent;
    font-size: 13px;
    letter-spacing: -0.3px;
}

#cartRemoveBtn {
    padding: 4px 11px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 8px;
    border: 1.5px solid rgba(239, 68, 68, 0.22);
    background: transparent;
    color: #f87171;
    letter-spacing: 0.1px;
}

#cartRemoveBtn:hover {
    background: rgba(239, 68, 68, 0.07);
    border-color: rgba(239, 68, 68, 0.4);
    color: #ef4444;
}

#salePanelFooter {
    background: #ffffff;
    border: none;
    border-top: 1px solid #f1f5f9;
    border-radius: 0 0 17px 17px;
}

#saleFooterItems {
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    background: transparent;
    letter-spacing: 0.2px;
}

#saleFooterSubtotal {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    background: transparent;
    letter-spacing: -0.5px;
}

#saleClearBtn {
    width: 100%;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 700;
    border-radius: 11px;
    border: 1.5px solid rgba(239, 68, 68, 0.22);
    background: transparent;
    color: #f87171;
    letter-spacing: 0.1px;
}

#saleClearBtn:hover:enabled {
    background: rgba(239, 68, 68, 0.07);
    border-color: rgba(239, 68, 68, 0.38);
    color: #ef4444;
}

#saleClearBtn:disabled {
    opacity: 0.38;
    color: #94a3b8;
    border-color: #e2e8f0;
}

/* ── Totals bar ─────────────────────────────────────────────── */
#totalsBar {
    border-top: 1px solid #e2e8f0;
    padding: 10px 14px;
    background: #ffffff;
}

#grandTotal {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.6px;
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════
   Payment method buttons
   ═══════════════════════════════════════════════════════════════ */
#payMethod {
    padding: 9px 8px;
    border-radius: 10px;
    border: 1.5px solid #e2e8f0;
    background: #f8fafc;
    color: #64748b;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.1px;
}

#payMethod:hover {
    border-color: #a5b4fc;
    background: rgba(99, 102, 241, 0.06);
    color: #4338ca;
}

#payMethod:checked {
    border-color: #6366f1;
    background: rgba(99, 102, 241, 0.1);
    color: #4338ca;
    font-weight: 800;
}

/* ═══════════════════════════════════════════════════════════════
   Numpad & cash inputs
   ═══════════════════════════════════════════════════════════════ */
#discountInput {
    font-size: 18px;
    font-weight: 800;
    background: #f8fafc;
    color: #0f172a;
    letter-spacing: -0.3px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 6px 10px;
}

#discountInput:focus {
    border-color: #6366f1;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
}

#discountPctLabel {
    font-size: 15px;
    font-weight: 700;
    color: #64748b;
    background: transparent;
}

#discountSaving {
    font-size: 11px;
    font-weight: 700;
    color: #10b981;
    background: transparent;
    letter-spacing: 0.1px;
}

#discountRowValue {
    font-size: 12px;
    font-weight: 700;
    color: #10b981;
    background: transparent;
}

#checkoutMiniValue {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    background: transparent;
}

#checkoutMiniLabel {
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    background: transparent;
}

#tenderedInput {
    font-size: 22px;
    font-weight: 800;
    background: #f8fafc;
    color: #0f172a;
    letter-spacing: -0.5px;
    border: 1.5px solid #e2e8f0;
    border-radius: 11px;
    padding: 10px 14px;
}

#tenderedInput:focus {
    border-color: #6366f1;
    background: #ffffff;
}

#changeAmount {
    font-size: 16px;
    font-weight: 800;
    color: #10b981;
    background: transparent;
    letter-spacing: -0.4px;
}

#errorHint {
    color: #f87171;
    font-size: 11px;
    background: transparent;
    font-weight: 600;
}

#numpadKey {
    min-height: 44px;
    font-size: 16px;
    font-weight: 700;
    border: 1.5px solid #e2e8f0;
    border-radius: 11px;
    background: #ffffff;
    color: #0f172a;
}

#numpadKey:hover {
    background: rgba(99, 102, 241, 0.06);
    border-color: #a5b4fc;
    color: #4338ca;
}

#numpadKey:pressed {
    background: rgba(99, 102, 241, 0.12);
    border-color: #6366f1;
    color: #4338ca;
}

/* ═══════════════════════════════════════════════════════════════
   Complete sale & primary action buttons
   ═══════════════════════════════════════════════════════════════ */
#completeSale {
    padding: 0 28px;
    font-size: 14px;
    font-weight: 800;
    border-radius: 12px;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1, stop:1 #4f46e5);
    color: #ffffff;
    letter-spacing: 0.1px;
}

#completeSale:disabled {
    background: #e2e8f0;
    color: #94a3b8;
}

#completeSale:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8, stop:1 #4338ca);
}

#completeSale:pressed:enabled {
    background: #4338ca;
}

#dangerButton {
    margin: 8px 12px 12px;
    padding: 10px;
    border-radius: 11px;
    border: 1.5px solid rgba(239, 68, 68, 0.25);
    background: transparent;
    color: #f87171;
    font-weight: 700;
}

#dangerButton:hover {
    background: rgba(239, 68, 68, 0.07);
    border-color: rgba(239, 68, 68, 0.45);
    color: #ef4444;
}

#primaryButton {
    padding: 8px 14px;
    border-radius: 10px;
    border: 1.5px solid rgba(99, 102, 241, 0.35);
    background: rgba(99, 102, 241, 0.08);
    font-weight: 700;
    color: #4338ca;
}

#primaryButton:hover {
    background: rgba(99, 102, 241, 0.14);
    border-color: #6366f1;
}

/* ═══════════════════════════════════════════════════════════════
   Receipt dialog
   ═══════════════════════════════════════════════════════════════ */
#receiptDialogTitle {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    background: transparent;
}

#receiptDialogSub, #receiptDialogHint {
    font-size: 12px;
    color: #64748b;
    background: transparent;
}

#receiptPreview {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 14px;
    color: #0f172a;
}

#receiptPrintBtn {
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 11px;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1, stop:1 #4f46e5);
    color: #ffffff;
}

#receiptPrintBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8, stop:1 #4338ca);
}

#receiptCloseBtn {
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 11px;
    border: 1.5px solid #e2e8f0;
    background: #f8fafc;
    color: #475569;
}

#receiptCloseBtn:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #334155;
}

/* ═══════════════════════════════════════════════════════════════
   Login dialog
   ═══════════════════════════════════════════════════════════════ */
#loginDialog {
    background: #ffffff;
}

#loginBrand {
    background: #ffffff;
}

#loginLogo {
    background: transparent;
}

#loginLogoFallback {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    background: transparent;
}

#loginTagline {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.5px;
    background: transparent;
}

#loginDivider {
    background: #e2e8f0;
}

#loginCard {
    background: #ffffff;
}

#loginTitle {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    background: transparent;
}

#loginSub {
    font-size: 12px;
    color: #64748b;
    line-height: 1.5;
    background: transparent;
}

#loginFieldLabel {
    font-size: 11px;
    font-weight: 700;
    color: #475569;
    background: transparent;
    letter-spacing: 0.3px;
}

#loginField {
    padding: 0 13px;
    font-size: 13px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
    color: #0f172a;
    selection-background-color: rgba(99, 102, 241, 0.28);
}

#loginField:focus {
    border-color: #6366f1;
    background: #ffffff;
}

#loginField:hover {
    border-color: #c7d2fe;
    background: #ffffff;
}

#loginCombo {
    padding: 0 11px;
    font-size: 13px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
    color: #0f172a;
}

#loginCombo:focus {
    border-color: #6366f1;
    background: #ffffff;
}

#loginCombo:disabled {
    background: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

#loginBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1,
        stop:1 #4f46e5);
    border: none;
    border-radius: 11px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

#loginBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8,
        stop:1 #4338ca);
}

#loginBtn:pressed {
    background: #4338ca;
}

/* ═══════════════════════════════════════════════════════════════
   Checkout button  (sale panel footer CTA)
   ═══════════════════════════════════════════════════════════════ */
#checkoutBtn {
    padding: 13px;
    font-size: 14px;
    font-weight: 800;
    border-radius: 13px;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1,
        stop:1 #4f46e5);
    color: #ffffff;
    letter-spacing: 0.2px;
}

#checkoutBtn:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8,
        stop:1 #4338ca);
}

#checkoutBtn:pressed:enabled {
    background: #4338ca;
}

#checkoutBtn:disabled {
    background: #e8ecf4;
    color: #94a3b8;
}

/* ═══════════════════════════════════════════════════════════════
   Checkout dialog
   ═══════════════════════════════════════════════════════════════ */
#checkoutDlg {
    background: #ffffff;
}

#checkoutSummary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4338ca,
        stop:1 #6366f1);
}

#checkoutSummaryLabel {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.4px;
    background: transparent;
}

#checkoutSummaryTotal {
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.7px;
    background: transparent;
}

#checkoutDivider {
    background: #e2e8f0;
}

#checkoutSection {
    font-size: 10px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.9px;
    background: transparent;
}

#checkoutFooter {
    background: #ffffff;
}

#checkoutCancelBtn {
    padding: 0 22px;
    border-radius: 11px;
    border: 1.5px solid #e2e8f0;
    background: #f8fafc;
    color: #64748b;
    font-weight: 700;
    font-size: 13px;
}

#checkoutCancelBtn:hover {
    background: #f1f5f9;
    border-color: #c7d2fe;
    color: #4338ca;
}

/* ═══════════════════════════════════════════════════════════════
   Keyboard shortcut hint bar  (bottom of main window)
   ═══════════════════════════════════════════════════════════════ */
#shortcutBar {
    background: transparent;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.25px;
    padding: 3px 8px 1px;
    border-top: 1px solid #edf0f5;
}

/* ═══════════════════════════════════════════════════════════════
   Add Product  —  top-bar trigger button
   ═══════════════════════════════════════════════════════════════ */
#addProductActionBtn {
    background: rgba(99, 102, 241, 0.1);
    border: 1.5px solid rgba(99, 102, 241, 0.32);
    border-radius: 11px;
    color: #6366f1;
    font-size: 20px;
    font-weight: 700;
    padding: 0;
}

#addProductActionBtn:hover {
    background: rgba(99, 102, 241, 0.18);
    border-color: #6366f1;
    color: #4f46e5;
}

#addProductActionBtn:pressed {
    background: rgba(99, 102, 241, 0.26);
    border-color: #4338ca;
}

/* ═══════════════════════════════════════════════════════════════
   Add Product dialog
   ═══════════════════════════════════════════════════════════════ */
#addProductDlg {
    background: #ffffff;
}

#addProductHeader {
    background: #ffffff;
}

#addProductTitle {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    background: transparent;
}

#addProductSub {
    font-size: 12px;
    color: #64748b;
    background: transparent;
}

#addProductError {
    color: #dc2626;
    font-size: 12px;
    font-weight: 600;
    background: rgba(220, 38, 38, 0.06);
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: 9px;
    padding: 9px 13px;
}

#addProductBtn {
    padding: 0 22px;
    border-radius: 11px;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1,
        stop:1 #4f46e5);
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1px;
}

#addProductBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8,
        stop:1 #4338ca);
}

#addProductBtn:pressed {
    background: #4338ca;
}

#addProductBtn:disabled {
    background: #e2e8f0;
    color: #94a3b8;
}

/* ═══════════════════════════════════════════════════════════════
   Return Dialog
   ═══════════════════════════════════════════════════════════════ */

#returnDialog {
    background: #f0f2f7;
}

#returnSearchRow {
    background: #ffffff;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
}

#returnSearchInput {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 10px;
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
}

#returnSearchInput:focus {
    border-color: #6366f1;
    background: #ffffff;
}

#returnFindBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1, stop:1 #4f46e5);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 700;
}

#returnFindBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8, stop:1 #4338ca);
}

#returnFindBtn:pressed {
    background: #4338ca;
}

#returnFindBtn:disabled {
    background: #e2e8f0;
    color: #94a3b8;
}

#returnErrorLbl {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

#returnSaleInfo {
    background: transparent;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    padding: 0 2px;
}

#returnPanel {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

#returnPanelHeader {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

#returnPanelTitle {
    background: transparent;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
}

#returnItemsScroll {
    background: transparent;
    border: none;
}

#returnItemsContainer {
    background: transparent;
}

#returnItemRow {
    background: transparent;
    border-radius: 6px;
}

#returnItemRow:hover {
    background: #f8fafc;
}

#returnItemName {
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #0f172a;
}

#returnItemSub {
    background: transparent;
    font-size: 11px;
    color: #94a3b8;
}

#returnItemQtyLbl {
    background: transparent;
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
}

#returnItemTotal {
    background: transparent;
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
}

#returnPlaceholder {
    background: transparent;
    color: #94a3b8;
    font-size: 13px;
    padding: 24px 16px;
}

#returnFieldLabel {
    background: transparent;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
}

#returnMethodBtn {
    background: #f1f5f9;
    color: #475569;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    padding: 0 8px;
}

#returnMethodBtn:hover {
    background: #e8edff;
    border-color: #a5b4fc;
    color: #4f46e5;
}

#returnMethodBtn:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1, stop:1 #4f46e5);
    color: #ffffff;
    border-color: #4f46e5;
}

#returnTextInput {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    color: #0f172a;
}

#returnTextInput:focus {
    border-color: #6366f1;
    background: #ffffff;
}

#returnTotalFrame {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
}

#returnTotalCaption {
    background: transparent;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: #94a3b8;
    text-transform: uppercase;
}

#returnTotalValue {
    background: transparent;
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
}

#returnFooterSep {
    color: #e2e8f0;
    background: #e2e8f0;
    max-height: 1px;
    border: none;
}

#returnCancelBtn {
    background: #f1f5f9;
    color: #475569;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    padding: 0 20px;
    min-width: 80px;
}

#returnCancelBtn:hover {
    background: #e2e8f0;
    color: #0f172a;
}

#returnProcessBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1, stop:1 #4f46e5);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    padding: 0 28px;
    min-width: 180px;
}

#returnProcessBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8, stop:1 #4338ca);
}

#returnProcessBtn:pressed {
    background: #4338ca;
}

#returnProcessBtn:disabled {
    background: #e2e8f0;
    color: #94a3b8;
}

/* ═══════════════════════════════════════════════════════════════
   Pagination bar
   ═══════════════════════════════════════════════════════════════ */
#paginationBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff,
        stop:1 #f8fafc);
    border-top: 1px solid #e8ecf5;
    border-radius: 0 0 17px 17px;
}

#pageNavBlock {
    background: transparent;
}

#pageNavBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1,
        stop:1 #4f46e5);
    border: none;
    border-radius: 18px;
    color: #ffffff;
    font-size: 20px;
    font-weight: 900;
    padding: 0;
}

#pageNavBtn:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5457e8,
        stop:1 #4338ca);
}

#pageNavBtn:pressed:enabled {
    background: #3730a3;
}

#pageNavBtn:disabled {
    background: #e8ecf5;
    color: #c7d2fe;
}

#pageInfoLabel {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.3px;
    background: transparent;
}

#pageTotalChip {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    background: transparent;
    letter-spacing: 0.1px;
}

/* Return button in sale panel footer */
#saleReturnBtn {
    background: rgba(245, 158, 11, 0.10);
    color: #92400e;
    border: 1.5px solid rgba(245, 158, 11, 0.30);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    padding: 6px 12px;
    min-height: 30px;
}

#saleReturnBtn:hover {
    background: rgba(245, 158, 11, 0.18);
    border-color: rgba(245, 158, 11, 0.50);
}

#saleReturnBtn:pressed {
    background: rgba(245, 158, 11, 0.25);
}

/* ══════════════════════════════════════════════════════════════════
   Purchase Order Dialogs  —  Professional Redesign
   ══════════════════════════════════════════════════════════════════ */

#purchaseOrderDialog, #poFormDialog {
    background: #f0f2f7;
}

/* ── Header ──────────────────────────────────────────────────────── */
#poGradientHeader {
    background: #ffffff;
    border-bottom: 1px solid #e8ecf5;
    min-height: 90px;
}

#poHeaderTitle {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.3px;
}

#poHeaderSubtitle {
    font-size: 12px;
    font-weight: 400;
    color: #64748b;
}

/* Refresh button */
#poHeaderRefreshBtn {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 14px;
    color: #475569;
    font-weight: 600;
    font-size: 13px;
}
#poHeaderRefreshBtn:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    color: #1e293b;
}
#poHeaderRefreshBtn:pressed {
    background: #e2e8f0;
}
#poHeaderRefreshBtn:disabled {
    color: #cbd5e1;
    border-color: #e8ecf5;
}

/* New PO button — indigo accent */
#poHeaderNewBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6366f1, stop:1 #4338ca);
    border: none;
    border-radius: 8px;
    padding: 0 18px;
    color: #ffffff;
    font-weight: 800;
    font-size: 13px;
}
#poHeaderNewBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #818cf8, stop:1 #6366f1);
}
#poHeaderNewBtn:pressed {
    background: #4338ca;
}

/* ── Filter pills ────────────────────────────────────────────────── */
#poFilterPill {
    background: #f1f5f9;
    border: 1.5px solid #e2e8f0;
    border-radius: 15px;
    padding: 0 14px;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
}
#poFilterPill:hover {
    background: #e2e8f0;
    color: #1e293b;
    border-color: #94a3b8;
}
#poFilterPill:checked {
    background: #6366f1;
    border-color: #6366f1;
    color: #ffffff;
    font-weight: 800;
}

/* ── Left list panel ─────────────────────────────────────────────── */
#poListPanel {
    background: #f8fafc;
    border-right: 1px solid #e2e8f0;
    min-width: 300px;
}

#poList {
    background: #f8fafc;
    border: none;
    outline: none;
}

#poList::item {
    border: none;
    padding: 0;
    background: transparent;
}

#poList::item:selected {
    background: transparent;
}

/* Custom list item widget */
#poListItem {
    background: #ffffff;
    border-bottom: 1px solid #f1f5f9;
}

#poListItem[selected="true"] {
    background: #eff6ff;
    border-left: 3px solid #6366f1;
}

#poListItem:hover {
    background: #f8fafc;
}

#poListPoNum {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
}

#poListItem[selected="true"] #poListPoNum {
    color: #1d4ed8;
}

#poListSupplier {
    font-size: 12px;
    font-weight: 500;
    color: #475569;
}

#poListDate {
    font-size: 11px;
    color: #94a3b8;
}

#poListAmount {
    font-size: 12px;
    font-weight: 700;
    color: #1e293b;
}

/* Empty state */
#poListEmpty {
    background: #f8fafc;
}
#poEmptyLabel {
    font-size: 13px;
    color: #94a3b8;
    font-style: italic;
}

/* ── Detail panel ────────────────────────────────────────────────── */
#poDetailStack, #poDetailScroll, #poDetailPage {
    background: #f0f2f7;
}

/* Placeholder page */
#poPlaceholderPage {
    background: #f0f2f7;
}
#poPlaceholderIcon {
    font-size: 48px;
    color: #cbd5e1;
}
#poPlaceholderLabel {
    font-size: 14px;
    font-weight: 500;
    color: #94a3b8;
    margin-top: 8px;
}

/* White detail cards */
#poDetailCard {
    background: #ffffff;
    border: 1px solid #e8ecf5;
    border-radius: 12px;
}

/* PO number */
#detPoNumber {
    font-size: 20px;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.5px;
}

/* Status badge — inline style applied from C++ per status */
#detStatusBadge {
    font-size: 11px;
    font-weight: 800;
    border-radius: 10px;
    padding: 3px 12px;
}

/* Meta keys / values */
#detMetaKey {
    font-size: 10px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.8px;
}

#detMetaVal {
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
}

/* Section labels */
#detSectionLabel {
    font-size: 10px;
    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 1px;
}

/* Items table */
#detItemsTable {
    background: #ffffff;
    border: 1px solid #eef0f6;
    border-radius: 8px;
    gridline-color: #f8fafc;
    selection-background-color: #eff6ff;
    alternate-background-color: #fafbff;
}

#detItemsTable QHeaderView {
    background: transparent;
}

#detItemsTable QHeaderView::section {
    background: #f8fafc;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
    border: none;
    border-bottom: 2px solid #eef0f6;
    padding: 8px 10px;
    letter-spacing: 0.6px;
}

#detItemsTable QHeaderView::section:first {
    border-top-left-radius: 8px;
}

#detItemsTable QHeaderView::section:last {
    border-top-right-radius: 8px;
}

/* Total label */
#detTotalLabel {
    font-size: 15px;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.2px;
}

/* ── Action bar ──────────────────────────────────────────────────── */
#poActionBar {
    background: #ffffff;
    border: 1px solid #e8ecf5;
    border-radius: 12px;
}

/* Place Order — indigo gradient */
#poPlaceBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6366f1, stop:1 #4338ca);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 22px;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.1px;
}
#poPlaceBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #818cf8, stop:1 #6366f1);
}
#poPlaceBtn:pressed  { background: #4338ca; }
#poPlaceBtn:disabled { background: #e2e8f0; color: #94a3b8; }

/* Mark Received — emerald gradient */
#poReceiveBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #10b981, stop:1 #047857);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 22px;
    font-weight: 800;
    font-size: 13px;
}
#poReceiveBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #34d399, stop:1 #10b981);
}
#poReceiveBtn:pressed  { background: #065f46; }
#poReceiveBtn:disabled { background: #e2e8f0; color: #94a3b8; }

/* Cancel PO — ghost danger */
#poCancelPoBtn {
    background: transparent;
    border: 1.5px solid #fca5a5;
    color: #ef4444;
    border-radius: 8px;
    padding: 0 22px;
    font-weight: 700;
    font-size: 13px;
}
#poCancelPoBtn:hover {
    background: #fef2f2;
    border-color: #ef4444;
    color: #dc2626;
}
#poCancelPoBtn:pressed  { background: #fee2e2; }
#poCancelPoBtn:disabled { color: #94a3b8; border-color: #e2e8f0; }

/* ── Bottom bar ──────────────────────────────────────────────────── */
#poBottomBar {
    background: #ffffff;
    border-top: 1px solid #e8ecf5;
}

#poCloseBtn {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 22px;
    color: #475569;
    font-weight: 700;
    font-size: 13px;
}
#poCloseBtn:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
    color: #1e293b;
}
#poCloseBtn:pressed { background: #e2e8f0; }

/* ── Splitter ────────────────────────────────────────────────────── */
#poSplitter::handle {
    background: #e2e8f0;
    width: 1px;
}

/* ── Shared divider ──────────────────────────────────────────────── */
#poDivider {
    background: #e8ecf5;
    color: #e8ecf5;
    max-height: 1px;
}

/* ── Form dialog ─────────────────────────────────────────────────── */
#poFormScroll, #poFormCanvas {
    background: #f0f2f7;
}

#poFormLabel {
    font-size: 10px;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.8px;
}

/* Supplier / date / expected fields */
#poSupplierCombo, #poDateEdit, #poExpectedEdit {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 12px;
    color: #1e293b;
    font-size: 13px;
    selection-background-color: #c7d2fe;
}
#poSupplierCombo:focus, #poDateEdit:focus, #poExpectedEdit:focus {
    border-color: #6366f1;
    background: #fafbff;
}
#poSupplierCombo:hover, #poDateEdit:hover, #poExpectedEdit:hover {
    border-color: #c7d2fe;
}

/* Notes text area */
#poNotesEdit {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1e293b;
    font-size: 13px;
}
#poNotesEdit:focus {
    border-color: #6366f1;
    background: #fafbff;
}

/* Product search combo */
#poProductCombo {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 12px;
    color: #1e293b;
    font-size: 13px;
}
#poProductCombo:focus { border-color: #6366f1; background: #fafbff; }
#poProductCombo:hover { border-color: #c7d2fe; }

/* Qty / cost small fields */
#poAddQty, #poAddCost {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 10px;
    color: #1e293b;
    font-size: 13px;
    font-weight: 600;
}
#poAddQty:focus, #poAddCost:focus {
    border-color: #6366f1;
    background: #fafbff;
}

/* Add Line button */
#poAddLineBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6366f1, stop:1 #4338ca);
    border: none;
    border-radius: 8px;
    padding: 0 18px;
    color: #ffffff;
    font-weight: 800;
    font-size: 13px;
}
#poAddLineBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #818cf8, stop:1 #6366f1);
}
#poAddLineBtn:pressed { background: #4338ca; }

/* Save as Draft */
#poSaveDraftBtn {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 0 22px;
    color: #475569;
    font-weight: 700;
    font-size: 13px;
}
#poSaveDraftBtn:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #1e293b;
}
#poSaveDraftBtn:pressed  { background: #f1f5f9; }
#poSaveDraftBtn:disabled { color: #94a3b8; border-color: #e2e8f0; }

/* Delete line × button */
#poDelLineBtn {
    background: transparent;
    border: none;
    color: #cbd5e1;
    font-size: 16px;
    font-weight: 900;
    border-radius: 5px;
}
#poDelLineBtn:hover {
    background: #fef2f2;
    color: #ef4444;
}
